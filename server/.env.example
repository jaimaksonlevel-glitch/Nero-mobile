# Required server-side secret. Never put this value in the mobile app.
OPENAI_API_KEY=replace-with-a-server-side-secret
OPENAI_MODEL=gpt-6-astra
PORT=8787
HOST=0.0.0.0

# Supabase Auth JWT validation. Enable an asymmetric ES256 or RS256 signing key.
# Issuer: https://<project-ref>.supabase.co/auth/v1
# Audience is the standard Supabase authenticated role.
AUTH_ISSUER=https://your-project-ref.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional: exact immutable subject (sub claim) for the creator account.
# Do not use an email address as the creator identifier.
CREATOR_SUBJECT=
