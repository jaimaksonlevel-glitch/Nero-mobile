{
  "expo": {
    "name": "Nero Mobile",
    "slug": "nero-mobile",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "backgroundColor": "#0B1020"
    },
    "android": {
      "package": "com.levelengenharia.neromobile"
    },
    "ios": {
      "bundleIdentifier": "com.levelengenharia.neromobile"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o Nero use o microfone somente quando você tocar no botão de gravação.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
